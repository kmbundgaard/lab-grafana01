  {
   "id": 10,
   "type": "table",
   "title": "Veeam services",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 10,
    "h": 14
   },
   "description": "Every Veeam (and PostgreSQL) systemd service with its current state.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_systemd_unit_state{job=\"veeam-appliances\",role=\"vsa\",host=~\"$vbr\",name=~\"(veeam.*|postgresql.*)[.]service\"} == 1",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "role": true,
       "__name__": true,
       "type": true,
       "Value": true
      },
      "indexByName": {
       "host": 0,
       "name": 1,
       "state": 2
      },
      "renameByName": {
       "host": "VBR",
       "name": "Service",
       "state": "State"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "State"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "active": {
            "text": "active",
            "color": "green",
            "index": 0
           },
           "failed": {
            "text": "FAILED",
            "color": "red",
            "index": 1
           },
           "inactive": {
            "text": "inactive",
            "color": "text",
            "index": 2
           },
           "activating": {
            "text": "activating",
            "color": "orange",
            "index": 3
           },
           "deactivating": {
            "text": "deactivating",
            "color": "orange",
            "index": 4
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "State",
      "desc": true
     }
    ]
   }
  },
