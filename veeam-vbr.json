{
 "uid": "veeam-vbr",
 "title": "Veeam lab - VBR servers",
 "tags": [
  "veeam",
  "lab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "title": "Overview",
   "type": "link",
   "url": "/d/veeam-overview",
   "icon": "dashboard"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "vbr",
    "label": "VBR server",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "query": {
     "query": "label_values(up{job=\"veeam-appliances\",role=\"vsa\"}, host)",
     "refId": "vbr"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
