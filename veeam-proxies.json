{
 "uid": "veeam-proxies",
 "title": "Veeam lab - proxies",
 "tags": [
  "veeam",
  "lab",
  "proxy"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "Single appliance detail",
   "type": "link",
   "url": "/d/veeam-lab",
   "icon": "dashboard"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "proxy",
    "label": "Proxy",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "query": {
     "query": "label_values(up{job=\"veeam-appliances\",role=\"proxy\"}, host)",
     "refId": "proxy"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Proxies down",
   "description": "Proxies whose built-in Node Exporter does not answer.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "0 - OK",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(up{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"} == 0) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Transport service not running",
   "description": "veeamtransport = the data mover that moves backup data. Not running = that proxy cannot process tasks.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 5,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "0 - OK",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(node_systemd_unit_state{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",name=\"veeamtransport.service\",state=\"active\"} == 0) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Veeam services failed",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "0 - OK",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(node_systemd_unit_state{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",name=~\"veeam.*[.]service\",state=\"failed\"} == 1) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Proxies monitored",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(up{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"})",
     "instant": true
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Busiest proxy CPU now",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(100 - avg by (host) (rate(node_cpu_seconds_total{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",mode=\"idle\"}[$__rate_interval])) * 100)",
     "instant": true
    }
   ]
  },
  {
   "id": 10,
   "type": "table",
   "title": "Proxy fleet",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 7
   },
   "description": "One row per proxy, current values. CPU over the dashboard's rate window.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "up{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"}",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host) (node_systemd_unit_state{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",name=\"veeamtransport.service\",state=\"active\"})",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",mode=\"idle\"}[$__rate_interval])) * 100",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"} / node_memory_MemTotal_bytes{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"})",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",mountpoint=\"/\"})",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (host) (rate(node_network_receive_bytes_total{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",device!~\"lo|veth.*\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\",device!~\"lo|veth.*\"}[$__rate_interval]))",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - node_boot_time_seconds{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"}",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "role": true,
       "__name__": true,
       "name": true,
       "state": true,
       "type": true
      },
      "indexByName": {
       "host": 0,
       "Value #A": 1,
       "Value #B": 2,
       "Value #C": 3,
       "Value #D": 4,
       "Value #E": 5,
       "Value #F": 6,
       "Value #G": 7
      },
      "renameByName": {
       "host": "Proxy",
       "Value #A": "Node Exporter",
       "Value #B": "Transport service",
       "Value #C": "CPU busy",
       "Value #D": "Memory used",
       "Value #E": "Root filesystem",
       "Value #F": "Network (in+out)",
       "Value #G": "Uptime"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Node Exporter"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "UP",
            "color": "green",
            "index": 0
           },
           "0": {
            "text": "DOWN",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Transport service"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "running",
            "color": "green",
            "index": 0
           },
           "0": {
            "text": "NOT running",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "CPU busy"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 80
          },
          {
           "color": "red",
           "value": 90
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Memory used"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 85
          },
          {
           "color": "red",
           "value": 95
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Root filesystem"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 80
          },
          {
           "color": "red",
           "value": 90
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       }
      ]
     },
     {
      "matcher": {
