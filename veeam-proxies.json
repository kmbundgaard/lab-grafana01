     "expr": "sum by (host) (rate(node_disk_read_bytes_total{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"}[$__rate_interval]) + rate(node_disk_written_bytes_total{job=\"veeam-appliances\",role=\"proxy\",host=~\"$proxy\"}[$__rate_interval]))",
     "legendFormat": "{{host}}"
    }
