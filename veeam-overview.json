  {
   "id": 10,
   "type": "table",
   "title": "All appliances",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 24,
    "h": 8
   },
   "description": "One row per appliance. Key services: VBR = backup, broker, PostgreSQL, REST API, identity; repository = immutability + transport; proxy = transport. Fullest filesystem = the most used XFS volume on that appliance.",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, role) (up{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\"})",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (host, role) (node_systemd_unit_state{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",state=\"active\",name=~\"(veeambackupsvc|veeambrokersvc|postgresql-17|veeamrestapisvc|veeamidentitysvc|veeamimmurepo|veeamtransport)[.]service\"} == bool 0)",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 - avg by (host, role) (rate(node_cpu_seconds_total{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",mode=\"idle\"}[$__rate_interval])) * 100",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\"} / node_memory_MemTotal_bytes{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\"})",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, role) (100 * (1 - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",fstype=\"xfs\"} / node_filesystem_size_bytes{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",fstype=\"xfs\"}))",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (host, role) (rate(node_network_receive_bytes_total{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",device!~\"lo|veth.*\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",device!~\"lo|veth.*\"}[$__rate_interval]))",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "time() - node_boot_time_seconds{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\"}",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "H",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (host, role, version) (veeam_component_info{job=\"veeam-appliances\",role=~\"$role\",host=~\"$host\",name=\"Veeam Deployment Service\"})",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "__name__": true,
       "Value #H": true
      },
      "indexByName": {
       "host": 0,
       "role": 1,
       "Value #A": 2,
       "Value #B": 3,
       "Value #C": 4,
       "Value #D": 5,
       "Value #E": 6,
       "Value #F": 7,
       "Value #G": 8,
       "version": 9
      },
      "renameByName": {
       "host": "Appliance",
       "role": "Role",
       "Value #A": "Node Exporter",
       "Value #B": "Key services",
       "Value #C": "CPU busy",
       "Value #D": "Memory used",
       "Value #E": "Fullest filesystem",
       "Value #F": "Network (in+out)",
       "Value #G": "Uptime",
       "version": "Veeam version"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Role"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "vsa": {
            "text": "VBR server",
            "index": 0
           },
           "hardened-repo": {
            "text": "Repository",
            "index": 1
           },
           "proxy": {
            "text": "Proxy",
            "index": 2
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Node Exporter"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "UP",
            "color": "green",
            "index": 0
           },
           "0": {
            "text": "DOWN",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Key services"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "all running",
            "color": "green",
            "index": 0
           }
          }
         },
         {
          "type": "range",
          "options": {
           "from": 1,
           "to": 99,
           "result": {
            "text": "NOT running",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "CPU busy"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 80
          },
          {
           "color": "red",
           "value": 90
          }
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "thresholds"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Memory used"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
