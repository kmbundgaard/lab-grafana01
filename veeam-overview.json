{
 "uid": "veeam-overview",
 "title": "Veeam lab - overview",
 "tags": [
  "veeam",
  "lab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "links": [
  {
   "title": "Proxies",
   "type": "link",
   "url": "/d/veeam-proxies",
   "icon": "dashboard"
  },
  {
   "title": "Single appliance detail",
   "type": "link",
   "url": "/d/veeam-lab",
   "icon": "dashboard"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "role",
    "label": "Role",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "query": {
     "query": "label_values(up{job=\"veeam-appliances\"}, role)",
     "refId": "role"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "host",
    "label": "Appliance",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "hide": 0,
    "query": {
     "query": "label_values(up{job=\"veeam-appliances\",role=~\"$role\"}, host)",
     "refId": "host"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
