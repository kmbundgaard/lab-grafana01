{
 "uid": "veeam-repositories",
 "title": "Veeam lab - repositories",
 "tags": [
  "veeam",
  "lab"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "links": [
  {
   "title": "Overview",
   "type": "link",
   "url": "/d/veeam-overview",
   "icon": "dashboard"
  }
 ],
 "templating": {
  "list": [
   {
    "name": "repo",
    "label": "Repository",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "multi": true,
    "includeAll": true,
    "query": {
     "query": "label_values(up{job=\"veeam-appliances\",role=\"hardened-repo\"}, host)",
     "refId": "repo"
    },
    "refresh": 2,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Repositories down",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "0 - OK",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(up{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\"} == 0) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Immutability service not running",
   "description": "veeamimmurepo = the hardened repository's immutability service.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "0 - OK",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(node_systemd_unit_state{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",name=\"veeamimmurepo.service\",state=\"active\"} == 0) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Transport service not running",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 9,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": null,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "0 - OK",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(node_systemd_unit_state{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",name=\"veeamtransport.service\",state=\"active\"} == 0) or vector(0)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Backup volume used (fullest)",
   "description": "/var/lib/veeam - the volume that holds the backups.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(100 * (1 - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"} / node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}))",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Estimated days until full",
   "description": "Free space on /var/lib/veeam divided by its growth over the last 24 h. Rough: needs at least a day of history, swings with retention and merges. Shows 'not growing' when free space is not shrinking.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 19,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "decimals": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 14
       },
       {
        "color": "green",
        "value": 30
       }
      ]
     },
     "mappings": [
      {
       "type": "special",
       "options": {
        "match": "null",
        "result": {
         "text": "not growing",
         "color": "green",
         "index": 0
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "center"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"} / ((-deriv(node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}[24h])) > 0) / 86400)",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 10,
   "type": "bargauge",
   "title": "Backup volume used per repository",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 6
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "namePlacement": "left"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"} / node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"})",
     "legendFormat": "{{host}}",
     "instant": true
    }
   ]
  },
  {
   "id": 11,
   "type": "table",
   "title": "Backup volume capacity",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"} - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}",
     "legendFormat": "",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "instance": true,
       "role": true,
       "device": true,
       "fstype": true,
       "__name__": true,
       "device_error": true
      },
      "indexByName": {
       "host": 0,
       "mountpoint": 1,
       "Value #A": 2,
       "Value #B": 3,
       "Value #C": 4
      },
      "renameByName": {
       "host": "Repository",
       "mountpoint": "Volume",
       "Value #A": "Size",
       "Value #B": "Used",
       "Value #C": "Free"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Backup volume used over time",
   "description": "Used space vs. the volume size. Steps up during backups, down when retention removes restore points.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "axisSoftMin": 0
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"} - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}",
     "legendFormat": "{{host}} used",
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mountpoint=\"/var/lib/veeam\"}",
     "legendFormat": "{{host}} size",
     "instant": false
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Write throughput (backups landing)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 10,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "axisSoftMin": 0
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (host) (rate(node_disk_written_bytes_total{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\"}[$__rate_interval]))",
     "legendFormat": "{{host}}",
     "instant": false
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Network in (data from proxies)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "axisSoftMin": 0
     },
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (host) (rate(node_network_receive_bytes_total{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",device!~\"lo|veth.*\"}[$__rate_interval]))",
     "legendFormat": "{{host}}",
     "instant": false
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "CPU busy",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 18,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "never",
      "spanNulls": true,
      "axisSoftMin": 0
     },
     "color": {
      "mode": "palette-classic"
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 - avg by (host) (rate(node_cpu_seconds_total{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",mode=\"idle\"}[$__rate_interval])) * 100",
     "legendFormat": "{{host}}",
     "instant": false
    }
   ]
  },
  {
   "id": 16,
   "type": "bargauge",
   "title": "All filesystems (XFS)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 26,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 80
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "namePlacement": "left"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",fstype=\"xfs\"} / node_filesystem_size_bytes{job=\"veeam-appliances\",role=\"hardened-repo\",host=~\"$repo\",fstype=\"xfs\"})",
     "legendFormat": "{{host}} {{mountpoint}}",
     "instant": true
    }
   ]
  },
  {
   "id": 20,
   "type": "logs",
   "title": "Repository syslog (warnings and worse)",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 12
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true,
    "showLabels": true
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "{job=\"syslog\", host=~\"$repo\", severity=~\"warning|error|critical|alert|emergency\"} !~ \"logcollector|file is not set\""
    }
   ]
  }
 ]
}